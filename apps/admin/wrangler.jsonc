{
  // Seiki web SaaS → Cloudflare Workers (Static Assets), mirroring
  // ~/Developer/sensei-hq/sensei/dojo/wrangler.jsonc. Committed so `wrangler deploy`
  // deploys the SvelteKit (adapter-cloudflare) output directly instead of running its
  // interactive auto-config. This is a WORKERS deploy (`wrangler deploy`), not a Pages
  // deploy. `name` must match the Cloudflare Worker/project name.
  //
  // apps/admin renders privileged data client-side via the gateway, BUT it still runs
  // SvelteKit server code — a Kavach `handle` hook (src/hooks.server.js) + a server
  // layout load (src/routes/+layout.server.ts). SvelteKit's own server runtime imports
  // `node:async_hooks` (AsyncLocalStorage), so the Worker throws at runtime on Cloudflare
  // without the `nodejs_compat` flag below. See `compatibility_flags`.
  //
  // Env is managed in the Cloudflare dashboard as encrypted SECRETS (never in git):
  //   PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY (publishable),
  //   PUBLIC_GATEWAY_URL=https://api-torii.sensei-hq.com
  // `wrangler deploy` never deletes Secrets; keep_vars:true also preserves any dashboard
  // plaintext Variables. At runtime SvelteKit reads these via $env/dynamic/public.
  // Local dev: `bun run dev` (Vite) reads the gitignored .env.
  "name": "seiki",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
