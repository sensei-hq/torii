{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "torii",
  "version": "0.1.1",
  "identifier": "dev.torii.app",
  "build": {
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build",
    "devUrl": "http://localhost:5274"
  },
  "app": {
    "windows": [
      {
        "title": "Torii",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
