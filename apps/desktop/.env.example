# Copy to apps/desktop/.env and fill in. All PUBLIC_* vars are inlined at build
# time via SvelteKit `$env/static/public`, so each must be defined for the build.

# Supabase project the desktop client authenticates against (Kavach client-only session).
PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# C1 central gateway — the cloud plane target (P2b split-plane). The desktop proxies
# /v1/chat here with the Supabase JWT; provider keys stay on the gateway, never here.
PUBLIC_GATEWAY_URL=http://127.0.0.1:8787
