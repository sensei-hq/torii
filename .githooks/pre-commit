#!/bin/sh
# Pre-commit gate — every commit is rustfmt-clean (cargo fmt --all --check).
#
# It CHECKS formatting rather than rewriting files, so it never surprise-edits your staged
# changes — run `make fmt` (cargo fmt --all), then re-commit. Enable per clone with
# `make hooks` (sets core.hooksPath=.githooks); CI runs the same check, so a clone without
# the hook is caught at the PR. Bypass a single commit with `git commit --no-verify`.
set -e
echo "pre-commit: cargo fmt --all --check…"
if ! cargo fmt --all --check >/dev/null; then
  echo "pre-commit: Rust code is not formatted — run 'make fmt' (cargo fmt --all) and re-commit." >&2
  exit 1
fi
