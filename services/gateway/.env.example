# torii-gateway environment — copy to services/gateway/.env (git-ignored) and fill in.
# The gateway loads this via dotenvy at startup (services/gateway is the CWD when run
# as the launchd service or via `cargo run` from here). Any shell-exported var takes
# precedence over this file, so an existing dev shell keeps working.

# ── Core (required) ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres   # Strategos local DB (55322)
HOST=127.0.0.1
PORT=8787

# ── Auth (required) ───────────────────────────────────────────────────────────
# JWKS is fetched from $PUBLIC_SUPABASE_URL/auth/v1/.well-known/jwks.json (RS256/ES256).
PUBLIC_SUPABASE_URL=http://127.0.0.1:55321                              # Strategos local API (55321)
# Optional HS256 fallback for local dev (shared JWT secret):
# SUPABASE_JWT_SECRET=

# ── Vault KEK (required for the F3 credential vault) ──────────────────────────
# base64-encoded 32 bytes. Dev only; prod resolves from a KMS/HSM. STRATEGOS_KEK is
# accepted as a fallback. Generate one:  openssl rand -base64 32
TORII_KEK=

# ── Provider keys (BYOK) — one per router `api_key_env_var` you actually use ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
