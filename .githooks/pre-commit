#!/bin/sh
# Pre-commit gate — every commit is rustfmt-clean and clippy-clean.
#
# Mirrors `make rust-lint`: `cargo fmt --all --check` (rejects unformatted code), then
# `make clippy` (`cargo clippy --workspace --all-targets -- -D warnings` on rustup's stable,
# the toolchain CI resolves). It CHECKS rather than rewriting files, so it never surprise-edits
# your staged changes — run `make fmt` (cargo fmt --all) or fix the lint, then re-commit.
# Enable per clone with `make hooks` (sets core.hooksPath=.githooks); CI (coverage.yml) runs
# the same checks, so a clone without the hook is caught at the PR. Bypass a single commit with
# `git commit --no-verify`.
set -e
echo "pre-commit: cargo fmt --all --check…"
if ! cargo fmt --all --check >/dev/null; then
  echo "pre-commit: Rust code is not formatted — run 'make fmt' (cargo fmt --all) and re-commit." >&2
  exit 1
fi
echo "pre-commit: cargo clippy --workspace --all-targets -- -D warnings…"
if ! make --no-print-directory clippy; then
  echo "pre-commit: clippy reported warnings — fix them (re-check with 'make clippy') and re-commit." >&2
  exit 1
fi
